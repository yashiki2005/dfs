#!/bin/sh
# dfs5cli: dfs5 をローカルで扱う CLI（rclone ライク）の起動ラッパー。
#
# `cryptography` の入った Python を探して dfs5/cli_main.py を呼ぶ。
# 環境変数 DFS5CLI_PYTHON で明示してもよい。
set -eu

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${DFS5CLI_PYTHON:-}" ]; then
    cd "$SELF_DIR"
    exec "$DFS5CLI_PYTHON" -m dfs5.cli_main "$@"
fi

for candidate in \
    "$HOME/dfs-venv/bin/python" \
    "$SELF_DIR/.venv/bin/python" \
    "$SELF_DIR/../.venv/bin/python" \
    "$(command -v python3 2>/dev/null || true)"
do
    [ -n "$candidate" ] || continue
    [ -x "$candidate" ] || continue
    if "$candidate" -c 'import cryptography' >/dev/null 2>&1; then
        cd "$SELF_DIR"
        exec "$candidate" -m dfs5.cli_main "$@"
    fi
done

echo "dfs5cli: 'cryptography' の入った Python が見つかりません。" >&2
echo "         DFS5CLI_PYTHON=/path/to/python を指定してください。" >&2
exit 127
