#!/bin/sh
# dfs5svc: ローカルに dfs5 サーバ（L2 + L3）を 1 つ立てる CLI の起動ラッパー。
#
# `cryptography` の入った Python を探して dfs5/svc.py を呼ぶ。
# 環境変数 DFS5R_PYTHON で明示してもよい（dfs5r と同じ約束）。
set -eu

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${DFS5R_PYTHON:-}" ]; then
    cd "$SELF_DIR"
    exec "$DFS5R_PYTHON" -m dfs5.svc "$@"
fi

for candidate in \
    "$HOME/dfs-venv/bin/python" \
    "$SELF_DIR/.venv/bin/python" \
    "$SELF_DIR/../.venv/bin/python" \
    "$(command -v python3 2>/dev/null || true)"
do
    [ -n "$candidate" ] || continue
    [ -x "$candidate" ] || continue
    if "$candidate" -c 'import cryptography' >/dev/null 2>&1; then
        cd "$SELF_DIR"
        exec "$candidate" -m dfs5.svc "$@"
    fi
done

echo "dfs5svc: 'cryptography' の入った Python が見つかりません。" >&2
echo "         DFS5R_PYTHON=/path/to/python を指定してください。" >&2
exit 127
